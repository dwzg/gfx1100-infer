  LINK_LIBRARIES = libgfxserver.a  libgfxgpu.a  libgfxcore.a  libgfxshaders.a  /usr/lib/x86_64-linux-gnu/libvulkan.so
  OBJECT_DIR = CMakeFiles/gfxi.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = gfxi
  TARGET_PDB = gfxi.dbg


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/gfx1100-infer/build2 && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/gfx1100-infer/build2 && /usr/bin/cmake --regenerate-during-build -S/home/user/gfx1100-infer -B/home/user/gfx1100-infer/build2
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


