#version 460
#extension GL_GOOGLE_include_directive : require
// Full attention for one query token. One workgroup per query head:
//   scores over the cached keys -> softmax -> weighted sum of cached values -> optional sigmoid gate
#include "common.glsl"
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer BQ { float q[]; };
layout(binding = 1) readonly buffer BGT { float gate[]; };
#ifdef KV8
layout(binding = 2) readonly buffer BKC { int kc8[]; };
layout(binding = 3) readonly buffer BVC { int vc8[]; };
layout(binding = 7) readonly buffer BKS { float16_t ks[]; };
layout(binding = 8) readonly buffer BVS { float16_t vs[]; };
#else
layout(binding = 2) readonly buffer BKC { float16_t kc[]; };
layout(binding = 3) readonly buffer BVC { float16_t vc[]; };
#endif
layout(binding = 4) readonly buffer BCTL { uint pos; } ctl;
layout(binding = 5) buffer BSC { float sc[]; };        // scratch: one row of n_ctx scores per head
layout(binding = 6) writeonly buffer BMIX { float mix[]; };
layout(push_constant) uniform PC { uint hd; uint nh; uint nkv; uint n_ctx; uint flags; float scale; } pc;
shared float red[256];

float reduce_max() {
    barrier();
    if (gl_LocalInvocationID.x == 0u) { float m = red[0]; for (uint i = 1u; i < 256u; i++) m = max(m, red[i]); red[0] = m; }
    barrier();
    float r = red[0];
    barrier();
    return r;
}
float reduce_sum() {
    barrier();
    if (gl_LocalInvocationID.x == 0u) { float s = 0.0; for (uint i = 0u; i < 256u; i++) s += red[i]; red[0] = s; }
    barrier();
    float r = red[0];
    barrier();
    return r;
}

void main() {
    uint h = gl_WorkGroupID.x, lid = gl_LocalInvocationID.x;
    uint kvh = h / (pc.nh / pc.nkv), n_pos = ctl.pos + 1u, row = pc.nkv * pc.hd;
    uint qb = h * pc.hd, sb = h * pc.n_ctx;

    float mx = -3.0e38;
    for (uint t = lid; t < n_pos; t += 256u) {
        uint kb = t * row + kvh * pc.hd;
        float s = 0.0;
#ifdef KV8
        for (uint blk = 0u; blk < pc.hd / 32u; blk++) {
            float a = 0.0;
            for (uint k = 0u; k < 8u; k++) {
                int wv = kc8[(kb >> 2) + blk * 8u + k]; uint d = qb + blk * 32u + k * 4u;
                a += float(bitfieldExtract(wv, 0, 8)) * q[d] + float(bitfieldExtract(wv, 8, 8)) * q[d + 1u]
                   + float(bitfieldExtract(wv, 16, 8)) * q[d + 2u] + float(wv >> 24) * q[d + 3u];
            }
            s += a * float(ks[(kb >> 5) + blk]);
        }
#else
        for (uint d = 0u; d < pc.hd; d++) s += q[qb + d] * float(kc[kb + d]);
#endif
        s *= pc.scale;
        sc[sb + t] = s;
        mx = max(mx, s);
    }
    red[lid] = mx;
    mx = reduce_max();

    float sum = 0.0;
    for (uint t = lid; t < n_pos; t += 256u) {
        float e = exp(sc[sb + t] - mx);
        sc[sb + t] = e;
        sum += e;
    }
    red[lid] = sum;
    memoryBarrierBuffer();
    float inv = 1.0 / reduce_sum();

    for (uint d = lid; d < pc.hd; d += 256u) {
        float acc = 0.0;
#ifdef KV8
        for (uint t = 0u; t < n_pos; t++) {
            uint e = t * row + kvh * pc.hd + d;
            acc += sc[sb + t] * float(bitfieldExtract(vc8[e >> 2], int(8u * (d & 3u)), 8)) * float(vs[e >> 5]);
        }
#else
        for (uint t = 0u; t < n_pos; t++) acc += sc[sb + t] * float(vc[t * row + kvh * pc.hd + d]);
#endif
        acc *= inv;
        if ((pc.flags & 1u) != 0u) acc *= sigmoid(gate[qb + d]);
        mix[qb + d] = acc;
    }
}
