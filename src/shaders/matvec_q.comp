#version 460
#extension GL_GOOGLE_include_directive : require
// y[row0 + r] = dot(W[r], x) for a quantised matrix in the plane-major layout (see engine/pack.h).
// One lane per output row: every weight load is 64 adjacent words per wave, and the input vector
// x is identical for all lanes. One source, specialised per weight format with FMT_*.
//
// All formats decode as   weight = scale_j * (code - offset_j)   per sub-block j, so a row is
//   sum_j scale_j * ( sum_i code_i * x_i  -  offset_j * X_j ),   X_j = sum of x over sub-block j.
// X_j comes precomputed (xs: sums over 16 columns), which keeps offsets out of the inner loop.
//
// BATCH builds the matrix-matrix form: T tokens per workgroup (gl_WorkGroupID.y selects the
// tile). Each weight is loaded and decoded once and multiplied into T accumulators, so the
// per-token cost is one multiply-add per weight. The format code below is written against a
// small set of accumulator operations that are scalar or T-wide.
#include "common.glsl"
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer BW { uint w[]; };
layout(binding = 1) readonly buffer BX { float x[]; };
layout(binding = 2) readonly buffer BXS { float xs[]; };
layout(binding = 3) writeonly buffer BY { float y[]; };
layout(binding = 4) readonly buffer BB { float bias[]; };
#ifdef BATCH
#define T 4u
layout(push_constant) uniform PC { uint n_sb; uint stride; uint n_rows; uint row0; uint flags; uint n_tokens; uint x_stride; uint xs_stride; uint y_stride; } pc;
uint g_x0, g_s0;                   // offsets of the tile's first token in x and xs
#define ACC float[T]
#define FOR_T for (uint t = 0u; t < T; t++)
#define A(a) a[t]
#define X(i) x[g_x0 + t * pc.x_stride + (i)]
#define XS(i) xs[g_s0 + t * pc.xs_stride + (i)]
#else
layout(push_constant) uniform PC { uint n_sb; uint stride; uint n_rows; uint row0; uint flags; } pc;
#define ACC float
#define FOR_T
#define A(a) a
#define X(i) x[i]
#define XS(i) xs[i]
#endif

#define M4 0x0F0F0F0Fu
#define BYTE(v, i) (((v) >> (8u * (i))) & 0xFFu)
uint g_base;                       // index of word 0 of the current super-block for this lane
#define LW(k) w[g_base + (k) * pc.stride]
ACC g_tot;                         // the row's running result

ACC acc_zero() { ACC a; FOR_T A(a) = 0.0; return a; }
// a += four weights (already floats) times four consecutive inputs
void acc_mul4(inout ACC a, vec4 f, uint xb) { FOR_T A(a) += f.x * X(xb) + f.y * X(xb + 1u) + f.z * X(xb + 2u) + f.w * X(xb + 3u); }
// four byte-packed unsigned codes
void acc_dot4(inout ACC a, uint v, uint xb) { acc_mul4(a, vec4(float(v & 0xFFu), float((v >> 8) & 0xFFu), float((v >> 16) & 0xFFu), float(v >> 24)), xb); }
void acc_axpy(inout ACC y_, float s, ACC a) { FOR_T A(y_) += s * A(a); }
// a += k * (sum of x over the 16-column block b)      /  over the 32 columns starting at block b
void acc_xs(inout ACC a, float k, uint b) { FOR_T A(a) += k * XS(b); }
void acc_xs32(inout ACC a, float k, uint b) { FOR_T A(a) += k * (XS(b) + XS(b + 1u)); }

#if defined(FMT_IQ4_XS) || defined(FMT_IQ4_NL) || defined(FMT_NVFP4)
// 16-entry codebooks, stored biased so every entry is an unsigned byte.
float lut(uint c) {
#if defined(FMT_NVFP4)
    // E2M1 values doubled {0,1,2,3,4,6,8,12, -0,-1,-2,-3,-4,-6,-8,-12}, biased by +12
    const uint64_t lo = 0x181412100F0E0D0CUL, hi = 0x00040608090A0B0CUL;
#else
    // IQ4 non-linear levels {-127,-104,-83,-65,-49,-35,-22,-10, 1,13,25,38,53,69,89,113}, biased by +127
    const uint64_t lo = 0x75695C4E3E2C1700UL, hi = 0xF0D8C4B4A5988C80UL;
#endif
    uint64_t t = (c & 8u) != 0u ? hi : lo;
    return float(uint(t >> ((c & 7u) * 8u)) & 0xFFu);
}
void acc_dot4c(inout ACC a, uint v, uint xb) { acc_mul4(a, vec4(lut(v & 0xFFu), lut((v >> 8) & 0xFFu), lut((v >> 16) & 0xFFu), lut(v >> 24)), xb); }
#endif

#if defined(FMT_Q4_K) || defined(FMT_Q5_K)
// 6-bit (scale, min) pair j from the 12 scale bytes held in words s0, s1, s2.
uvec2 scale_min(uint j, uint s0, uint s1, uint s2) {
    if (j < 4u) return uvec2((s0 >> (8u * j)) & 63u, (s1 >> (8u * j)) & 63u);
    uint jj = j - 4u;
    return uvec2(((s2 >> (8u * jj)) & 15u) | (((s0 >> (8u * jj + 6u)) & 3u) << 4),
                 ((s2 >> (8u * jj + 4u)) & 15u) | (((s1 >> (8u * jj + 6u)) & 3u) << 4));
}
#endif

#if defined(FMT_Q4_K) || defined(FMT_Q5_K)
#define SB 256u
#if defined(FMT_Q4_K)
#define NW 36u
#define QS0 4u
#else
#define NW 44u
#define QS0 12u
#endif
// words: 0 = d | dmin<<16, 1..3 = scales, [Q5_K: 4..11 = high bits,] then 32 words of nibbles
// (low nibble: first 32 columns of a pair of sub-blocks).   weight = d * scale * code - dmin * min
void superblock(uint xb) {
    vec2 dm = unpackHalf2x16(LW(0u));
    uint s0 = LW(1u), s1 = LW(2u), s2 = LW(3u), sx = xb >> 4;
    for (uint g = 0u; g < 4u; g++) {
        ACC a = acc_zero(), b = acc_zero();
        for (uint k = 0u; k < 8u; k++) {
            uint v = LW(QS0 + 8u * g + k), c = xb + 64u * g + 4u * k;
#if defined(FMT_Q4_K)
            acc_dot4(a, v & M4, c);
            acc_dot4(b, (v >> 4) & M4, c + 32u);
#else
            uint h = LW(4u + k);
            acc_dot4(a, (v & M4) | (((h >> (2u * g)) & 0x01010101u) << 4), c);
            acc_dot4(b, ((v >> 4) & M4) | (((h >> (2u * g + 1u)) & 0x01010101u) << 4), c + 32u);
#endif
        }
        uvec2 ja = scale_min(2u * g, s0, s1, s2), jb = scale_min(2u * g + 1u, s0, s1, s2);
        acc_axpy(g_tot, dm.x * float(ja.x), a);
        acc_axpy(g_tot, dm.x * float(jb.x), b);
        acc_xs32(g_tot, -dm.y * float(ja.y), sx + 4u * g);
        acc_xs32(g_tot, -dm.y * float(jb.y), sx + 4u * g + 2u);
    }
}
#elif defined(FMT_Q6_K)
#define SB 256u
#define NW 53u
// words: 0..31 = low nibbles, 32..47 = high 2 bits, 48..51 = int8 scales, 52 = d.   weight = d * scale * (code - 32)
float scale8(uint idx) { return float(bitfieldExtract(int(LW(48u + (idx >> 2))), int(8u * (idx & 3u)), 8)); }
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(52u)).x;
    uint sx = xb >> 4;
    // Each half (n) holds four quarters of 32 columns; quarter q takes the low (q < 2) or high
    // nibbles of the first (q even) or second (q odd) 32 bytes, and bit pair q of the high bits.
    for (uint n = 0u; n < 2u; n++)
        for (uint is = 0u; is < 2u; is++)
            for (uint q = 0u; q < 4u; q++) {
                ACC a = acc_zero();
                for (uint k4 = 0u; k4 < 4u; k4++) {
                    uint kk = 4u * is + k4;
                    uint lo = LW(16u * n + 8u * (q & 1u) + kk), h = LW(32u + 8u * n + kk);
                    uint nib = q >= 2u ? (lo >> 4) & M4 : lo & M4;
                    acc_dot4(a, nib | (((h >> (2u * q)) & 0x03030303u) << 4), xb + 128u * n + 32u * q + 4u * kk);
                }
                uint si = 8u * n + is + 2u * q;       // scale / 16-column block index
                float f = d * scale8(si);
                acc_axpy(g_tot, f, a); acc_xs(g_tot, -32.0 * f, sx + si);
            }
}
#elif defined(FMT_Q3_K)
#define SB 256u
#define NW 28u
// words: 0..7 = high bit masks, 8..23 = 2-bit codes, 24..26 = packed 6-bit scales, 27 = d.
// weight = d * (scale - 32) * (code - 4), code = low 2 bits + 4 * high bit
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(27u)).x;
    uint a0 = LW(24u), a1 = LW(25u), tt = LW(26u), sx = xb >> 4;
    uint sw[4];
    sw[0] = (a0 & M4) | ((tt & 0x03030303u) << 4);          sw[1] = (a1 & M4) | (((tt >> 2) & 0x03030303u) << 4);
    sw[2] = ((a0 >> 4) & M4) | (((tt >> 4) & 0x03030303u) << 4); sw[3] = ((a1 >> 4) & M4) | (((tt >> 6) & 0x03030303u) << 4);
    for (uint n = 0u; n < 2u; n++)
        for (uint j = 0u; j < 4u; j++)
            for (uint hh = 0u; hh < 2u; hh++) {
                ACC a = acc_zero();
                for (uint k = 0u; k < 4u; k++) {
                    uint q = LW(8u + 8u * n + 4u * hh + k), hm = LW(4u * hh + k);
                    acc_dot4(a, ((q >> (2u * j)) & 0x03030303u) | (((hm >> (4u * n + j)) & 0x01010101u) << 2), xb + 128u * n + 32u * j + 16u * hh + 4u * k);
                }
                uint is = 8u * n + 2u * j + hh;
                float f = d * float(int(BYTE(sw[is >> 2], is & 3u)) - 32);
                acc_axpy(g_tot, f, a); acc_xs(g_tot, -4.0 * f, sx + is);
            }
}
#elif defined(FMT_IQ4_XS)
#define SB 256u
#define NW 34u
// words: 0 = d | scales_h<<16, 1 = scales_l, 2..33 = nibbles.   weight = d * (ls - 32) * level[code]
void superblock(uint xb) {
    uint w0 = LW(0u), sl = LW(1u), sx = xb >> 4;
    float d = unpackHalf2x16(w0).x;
    for (uint ib = 0u; ib < 8u; ib++) {
        ACC a = acc_zero();
        for (uint k = 0u; k < 4u; k++) {
            uint v = LW(2u + 4u * ib + k), c = xb + 32u * ib + 4u * k;
            acc_dot4c(a, v & M4, c); acc_dot4c(a, (v >> 4) & M4, c + 16u);
        }
        uint ls = ((sl >> (4u * ib)) & 15u) | (((w0 >> (16u + 2u * ib)) & 3u) << 4);
        float f = d * float(int(ls) - 32);
        acc_axpy(g_tot, f, a); acc_xs32(g_tot, -127.0 * f, sx + 2u * ib);
    }
}
#elif defined(FMT_IQ4_NL) || defined(FMT_Q4_0)
#define SB 64u
#define NW 9u
// words: 0 = d0 | d1<<16, 1..4 = nibbles of block 0, 5..8 = nibbles of block 1
void superblock(uint xb) {
    vec2 dd = unpackHalf2x16(LW(0u));
    uint sx = xb >> 4;
    for (uint blk = 0u; blk < 2u; blk++) {
        ACC a = acc_zero();
        for (uint k = 0u; k < 4u; k++) {
            uint v = LW(1u + 4u * blk + k), c = xb + 32u * blk + 4u * k;
#if defined(FMT_IQ4_NL)
            acc_dot4c(a, v & M4, c); acc_dot4c(a, (v >> 4) & M4, c + 16u);
#else
            acc_dot4(a, v & M4, c); acc_dot4(a, (v >> 4) & M4, c + 16u);
#endif
        }
        acc_axpy(g_tot, dd[blk], a);
#if defined(FMT_IQ4_NL)
        acc_xs32(g_tot, -127.0 * dd[blk], sx + 2u * blk);
#else
        acc_xs32(g_tot, -8.0 * dd[blk], sx + 2u * blk);
#endif
    }
}
#elif defined(FMT_Q8_0)
#define SB 64u
#define NW 17u
// words: 0 = d0 | d1<<16, 1..8 = bytes of block 0 (biased by 128), 9..16 = bytes of block 1
void superblock(uint xb) {
    vec2 dd = unpackHalf2x16(LW(0u));
    uint sx = xb >> 4;
    for (uint blk = 0u; blk < 2u; blk++) {
        ACC a = acc_zero();
        for (uint k = 0u; k < 8u; k++) acc_dot4(a, LW(1u + 8u * blk + k), xb + 32u * blk + 4u * k);
        acc_axpy(g_tot, dd[blk], a); acc_xs32(g_tot, -128.0 * dd[blk], sx + 2u * blk);
    }
}
#elif defined(FMT_NVFP4)
#define SB 64u
#define NW 9u
// words: 0 = four UE4M3 sub-block scales, 1..8 = nibbles (sub-block s: words 1+2s, 2+2s)
float ue4m3_half(uint b) {
    uint e = (b >> 3) & 15u, m = b & 7u;
    float v = e == 0u ? float(m) * (1.0 / 1024.0) : uintBitsToFloat(((e + 119u) << 23) | (m << 20));
    return (b == 0u || b == 0x7Fu) ? 0.0 : v;
}
void superblock(uint xb) {
    uint w0 = LW(0u), sx = xb >> 4;
    for (uint s = 0u; s < 4u; s++) {
        ACC a = acc_zero();
        for (uint k = 0u; k < 2u; k++) {
            uint v = LW(1u + 2u * s + k), c = xb + 16u * s + 4u * k;
            acc_dot4c(a, v & M4, c); acc_dot4c(a, (v >> 4) & M4, c + 8u);
        }
        float f = ue4m3_half(BYTE(w0, s));
        acc_axpy(g_tot, f, a); acc_xs(g_tot, -12.0 * f, sx + s);
    }
}
#elif defined(FMT_IQ3_S) || defined(FMT_IQ3_XXS) || defined(FMT_IQ2_S) || defined(FMT_IQ2_XS) || defined(FMT_IQ2_XXS)
// Codebook formats: an index selects a group of unsigned magnitudes from a table, with a separate
// sign bit per weight.   weight = d * block_scale * (+-magnitude)
#define SB 256u
layout(binding = 5) readonly buffer BG { uint grid[]; };
float sgn(uint mag, uint bit) { return uintBitsToFloat(floatBitsToUint(float(mag)) ^ (bit << 31)); }
// Four magnitudes (bytes of m) with sign bits sg[0..3], times four consecutive inputs.
void acc_dot4s(inout ACC a, uint m, uint sg, uint xb) {
    acc_mul4(a, vec4(sgn(m & 0xFFu, sg & 1u), sgn((m >> 8) & 0xFFu, (sg >> 1) & 1u), sgn((m >> 16) & 0xFFu, (sg >> 2) & 1u), sgn(m >> 24, (sg >> 3) & 1u)), xb);
}
// Eight magnitudes from a table of 64-bit entries, stored as two words each.
void acc_dot8s(inout ACC a, uint idx, uint sg, uint xb) { acc_dot4s(a, grid[2u * idx], sg, xb); acc_dot4s(a, grid[2u * idx + 1u], sg >> 4, xb + 4u); }
// Sign byte for eight weights from its 7 stored bits: the eighth bit makes the parity even.
uint signs8(uint s7) { return s7 | ((uint(bitCount(s7)) & 1u) << 7); }

#if defined(FMT_IQ3_S)
#define NW 28u
// words: 0 = d, 1 = eight 4-bit scales, 2..3 = high index bits, 4..19 = index bytes, 20..27 = sign bytes; table: 512 x 4
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(0u)).x;
    uint scales = LW(1u);
    for (uint ib = 0u; ib < 8u; ib++) {
        uint q0 = LW(4u + 2u * ib), q1 = LW(5u + 2u * ib), sgw = LW(20u + ib);
        uint qh = BYTE(LW(2u + (ib >> 2)), ib & 3u);
        ACC a = acc_zero();
        for (uint l = 0u; l < 4u; l++) {
            uint qw = l < 2u ? q0 : q1, sh = 2u * (l & 1u);
            uint i1 = BYTE(qw, sh) | ((qh << (8u - 2u * l)) & 256u), i2 = BYTE(qw, sh + 1u) | ((qh << (7u - 2u * l)) & 256u);
            uint sg = BYTE(sgw, l), c = xb + 32u * ib + 8u * l;
            acc_dot4s(a, grid[i1], sg, c); acc_dot4s(a, grid[i2], sg >> 4, c + 4u);
        }
        acc_axpy(g_tot, d * float(1u + 2u * ((scales >> (4u * ib)) & 15u)), a);
    }
}
#elif defined(FMT_IQ3_XXS)
#define NW 25u
// words: 0 = d, 1..16 = index bytes, 17..24 = four 7-bit sign groups + 4-bit scale; table: 256 x 4
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(0u)).x;
    for (uint ib = 0u; ib < 8u; ib++) {
        uint q0 = LW(1u + 2u * ib), q1 = LW(2u + 2u * ib), sas = LW(17u + ib);
        ACC a = acc_zero();
        for (uint l = 0u; l < 4u; l++) {
            uint qw = l < 2u ? q0 : q1, sh = 2u * (l & 1u), sg = signs8((sas >> (7u * l)) & 127u), c = xb + 32u * ib + 8u * l;
            acc_dot4s(a, grid[BYTE(qw, sh)], sg, c); acc_dot4s(a, grid[BYTE(qw, sh + 1u)], sg >> 4, c + 4u);
        }
        acc_axpy(g_tot, d * 0.5 * (0.5 + float(sas >> 28)), a);
    }
}
#elif defined(FMT_IQ2_S)
#define NW 21u
// words: 0 = d, 1..8 = index bytes, 9..16 = sign bytes, 17..18 = high index bits, 19..20 = two 4-bit scales per 32 weights; table: 1024 x 8
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(0u)).x;
    for (uint ib = 0u; ib < 8u; ib++) {
        uint qw = LW(1u + ib), sgw = LW(9u + ib), qh = BYTE(LW(17u + (ib >> 2)), ib & 3u), sc = BYTE(LW(19u + (ib >> 2)), ib & 3u);
        for (uint hf = 0u; hf < 2u; hf++) {
            ACC a = acc_zero();
            for (uint l = 2u * hf; l < 2u * hf + 2u; l++)
                acc_dot8s(a, BYTE(qw, l) | ((qh << (8u - 2u * l)) & 0x300u), BYTE(sgw, l), xb + 32u * ib + 8u * l);
            acc_axpy(g_tot, d * 0.25 * (0.5 + float((sc >> (4u * hf)) & 15u)), a);
        }
    }
}
#elif defined(FMT_IQ2_XS)
#define NW 19u
// words: 0 = d, 1..16 = 16-bit codes (9-bit index, 7 sign bits), 17..18 = two 4-bit scales per 32 weights; table: 512 x 8
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(0u)).x;
    for (uint ib = 0u; ib < 8u; ib++) {
        uint sc = BYTE(LW(17u + (ib >> 2)), ib & 3u);
        for (uint hf = 0u; hf < 2u; hf++) {
            uint qw = LW(1u + 2u * ib + hf);
            ACC a = acc_zero();
            for (uint l = 0u; l < 2u; l++) {
                uint v = (qw >> (16u * l)) & 0xFFFFu;
                acc_dot8s(a, v & 511u, signs8(v >> 9), xb + 32u * ib + 16u * hf + 8u * l);
            }
            acc_axpy(g_tot, d * 0.25 * (0.5 + float((sc >> (4u * hf)) & 15u)), a);
        }
    }
}
#else
#define NW 17u
// IQ2_XXS words: 0 = d, then per 32 weights: four index bytes, and four 7-bit sign groups + 4-bit scale; table: 256 x 8
void superblock(uint xb) {
    float d = unpackHalf2x16(LW(0u)).x;
    for (uint ib = 0u; ib < 8u; ib++) {
        uint qw = LW(1u + 2u * ib), sas = LW(2u + 2u * ib);
        ACC a = acc_zero();
        for (uint l = 0u; l < 4u; l++) acc_dot8s(a, BYTE(qw, l), signs8((sas >> (7u * l)) & 127u), xb + 32u * ib + 8u * l);
        acc_axpy(g_tot, d * 0.25 * (0.5 + float(sas >> 28)), a);
    }
}
#endif
#else
#error "no weight format selected"
#endif

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.stride) return;
    g_tot = acc_zero();
#ifdef BATCH
    uint t0 = gl_WorkGroupID.y * T;
    g_x0 = t0 * pc.x_stride; g_s0 = t0 * pc.xs_stride;
#endif
    for (uint s = 0u; s < pc.n_sb; s++) {
        g_base = s * NW * pc.stride + row;
        superblock(s * SB);
    }
    if (row >= pc.n_rows) return;
    float bv = (pc.flags & 1u) != 0u ? bias[pc.row0 + row] : 0.0;
#ifdef BATCH
    FOR_T if (t0 + t < pc.n_tokens) y[(t0 + t) * pc.y_stride + pc.row0 + row] = g_tot[t] + bv;
#else
    y[pc.row0 + row] = g_tot + bv;
#endif
}
