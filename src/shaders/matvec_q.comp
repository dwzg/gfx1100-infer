#version 460
#extension GL_GOOGLE_include_directive : require
// y[row0 + r] = dot(W[r], x) for a quantised matrix in the plane-major layout (see engine/pack.h).
// One lane per output row: every weight load is 64 adjacent words per wave, and the input vector
// x is identical for all lanes. One source, specialised per weight format with FMT_*.
//
// All formats decode as   weight = scale_j * (code - offset_j)   per sub-block j, so a row is
//   sum_j scale_j * ( sum_i code_i * x_i  -  offset_j * X_j ),   X_j = sum of x over sub-block j.
// X_j comes precomputed (xs: sums over 16 columns), which keeps offsets out of the inner loop.
#include "common.glsl"
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer BW { uint w[]; };
layout(binding = 1) readonly buffer BX { float x[]; };
layout(binding = 2) readonly buffer BXS { float xs[]; };
layout(binding = 3) writeonly buffer BY { float y[]; };
layout(binding = 4) readonly buffer BB { float bias[]; };
layout(push_constant) uniform PC { uint n_sb; uint stride; uint n_rows; uint row0; uint flags; } pc;

#define M4 0x0F0F0F0Fu
uint g_base;                       // index of word 0 of the current super-block for this lane
#define LW(k) w[g_base + (k) * pc.stride]

// Four byte-packed codes times four consecutive inputs.
float dot4(uint v, uint xb) {
    return float(v & 0xFFu) * x[xb] + float((v >> 8) & 0xFFu) * x[xb + 1u] + float((v >> 16) & 0xFFu) * x[xb + 2u] + float(v >> 24) * x[xb + 3u];
}
// Sum of x over 32 columns starting at 16-column block b.
float xsum32(uint b) { return xs[b] + xs[b + 1u]; }

#if defined(FMT_IQ4_XS) || defined(FMT_IQ4_NL) || defined(FMT_NVFP4)
// 16-entry codebooks, stored biased so every entry is an unsigned byte.
float lut(uint c) {
#if defined(FMT_NVFP4)
    // E2M1 values doubled {0,1,2,3,4,6,8,12, -0,-1,-2,-3,-4,-6,-8,-12}, biased by +12
    const uint64_t lo = 0x181412100F0E0D0CUL, hi = 0x00040608090A0B0CUL;
#else
    // IQ4 non-linear levels {-127,-104,-83,-65,-49,-35,-22,-10, 1,13,25,38,53,69,89,113}, biased by +127
    const uint64_t lo = 0x75695C4E3E2C1700UL, hi = 0xF0D8C4B4A5988C80UL;
#endif
    uint64_t t = (c & 8u) != 0u ? hi : lo;
    return float(uint(t >> ((c & 7u) * 8u)) & 0xFFu);
}
float dot4c(uint v, uint xb) {
    return lut(v & 0xFFu) * x[xb] + lut((v >> 8) & 0xFFu) * x[xb + 1u] + lut((v >> 16) & 0xFFu) * x[xb + 2u] + lut(v >> 24) * x[xb + 3u];
}
#endif

#if defined(FMT_Q4_K) || defined(FMT_Q5_K)
// 6-bit (scale, min) pair j from the 12 scale bytes held in words s0, s1, s2.
uvec2 scale_min(uint j, uint s0, uint s1, uint s2) {
    if (j < 4u) return uvec2((s0 >> (8u * j)) & 63u, (s1 >> (8u * j)) & 63u);
    uint jj = j - 4u;
    return uvec2(((s2 >> (8u * jj)) & 15u) | (((s0 >> (8u * jj + 6u)) & 3u) << 4),
                 ((s2 >> (8u * jj + 4u)) & 15u) | (((s1 >> (8u * jj + 6u)) & 3u) << 4));
}
#endif

#if defined(FMT_Q4_K)
#define SB 256u
#define NW 36u
// words: 0 = d | dmin<<16, 1..3 = scales, 4..35 = nibbles (low nibble: first 32 columns of a pair of sub-blocks)
float superblock(uint xb) {
    vec2 dm = unpackHalf2x16(LW(0u));
    uint s0 = LW(1u), s1 = LW(2u), s2 = LW(3u), sx = xb >> 4;
    float acc = 0.0, accm = 0.0;
    for (uint g = 0u; g < 4u; g++) {
        float a = 0.0, b = 0.0;
        for (uint k = 0u; k < 8u; k++) {
            uint v = LW(4u + 8u * g + k), c = xb + 64u * g + 4u * k;
            a += dot4(v & M4, c);
            b += dot4((v >> 4) & M4, c + 32u);
        }
        uvec2 ja = scale_min(2u * g, s0, s1, s2), jb = scale_min(2u * g + 1u, s0, s1, s2);
        acc += float(ja.x) * a + float(jb.x) * b;
        accm += float(ja.y) * xsum32(sx + 4u * g) + float(jb.y) * xsum32(sx + 4u * g + 2u);
    }
    return dm.x * acc - dm.y * accm;
}
#elif defined(FMT_Q5_K)
#define SB 256u
#define NW 44u
// words: 0 = d | dmin<<16, 1..3 = scales, 4..11 = high bits, 12..43 = nibbles
float superblock(uint xb) {
    vec2 dm = unpackHalf2x16(LW(0u));
    uint s0 = LW(1u), s1 = LW(2u), s2 = LW(3u), sx = xb >> 4;
    float acc = 0.0, accm = 0.0;
    for (uint g = 0u; g < 4u; g++) {
        float a = 0.0, b = 0.0;
        for (uint k = 0u; k < 8u; k++) {
            uint v = LW(12u + 8u * g + k), h = LW(4u + k), c = xb + 64u * g + 4u * k;
            a += dot4((v & M4) | (((h >> (2u * g)) & 0x01010101u) << 4), c);
            b += dot4(((v >> 4) & M4) | (((h >> (2u * g + 1u)) & 0x01010101u) << 4), c + 32u);
        }
        uvec2 ja = scale_min(2u * g, s0, s1, s2), jb = scale_min(2u * g + 1u, s0, s1, s2);
        acc += float(ja.x) * a + float(jb.x) * b;
        accm += float(ja.y) * xsum32(sx + 4u * g) + float(jb.y) * xsum32(sx + 4u * g + 2u);
    }
    return dm.x * acc - dm.y * accm;
}
#elif defined(FMT_Q6_K)
#define SB 256u
#define NW 53u
// words: 0..31 = low nibbles, 32..47 = high 2 bits, 48..51 = int8 scales, 52 = d.   weight = d * scale * (code - 32)
float scale8(uint idx) { return float(bitfieldExtract(int(LW(48u + (idx >> 2))), int(8u * (idx & 3u)), 8)); }
float superblock(uint xb) {
    float d = unpackHalf2x16(LW(52u)).x;
    uint sx = xb >> 4;
    float acc = 0.0;
    for (uint n = 0u; n < 2u; n++) {
        for (uint is = 0u; is < 2u; is++) {
            float a1 = 0.0, a2 = 0.0, a3 = 0.0, a4 = 0.0;
            for (uint k4 = 0u; k4 < 4u; k4++) {
                uint kk = 4u * is + k4;
                uint a = LW(16u * n + kk), b = LW(16u * n + 8u + kk), h = LW(32u + 8u * n + kk), c = xb + 128u * n + 4u * kk;
                a1 += dot4((a & M4) | ((h & 0x03030303u) << 4), c);
                a2 += dot4((b & M4) | (((h >> 2) & 0x03030303u) << 4), c + 32u);
                a3 += dot4(((a >> 4) & M4) | (((h >> 4) & 0x03030303u) << 4), c + 64u);
                a4 += dot4(((b >> 4) & M4) | (((h >> 6) & 0x03030303u) << 4), c + 96u);
            }
            uint si = 8u * n + is;        // scale / 16-column block index of the first quarter
            acc += scale8(si) * (a1 - 32.0 * xs[sx + si]) + scale8(si + 2u) * (a2 - 32.0 * xs[sx + si + 2u])
                 + scale8(si + 4u) * (a3 - 32.0 * xs[sx + si + 4u]) + scale8(si + 6u) * (a4 - 32.0 * xs[sx + si + 6u]);
        }
    }
    return d * acc;
}
#elif defined(FMT_Q3_K)
#define SB 256u
#define NW 28u
// words: 0..7 = high bit masks, 8..23 = 2-bit codes, 24..26 = packed 6-bit scales, 27 = d.
// weight = d * (scale - 32) * (code - 4), code = low 2 bits + 4 * high bit
float superblock(uint xb) {
    float d = unpackHalf2x16(LW(27u)).x;
    uint a0 = LW(24u), a1 = LW(25u), t = LW(26u), sx = xb >> 4;
    uint sw[4];
    sw[0] = (a0 & M4) | ((t & 0x03030303u) << 4);          sw[1] = (a1 & M4) | (((t >> 2) & 0x03030303u) << 4);
    sw[2] = ((a0 >> 4) & M4) | (((t >> 4) & 0x03030303u) << 4); sw[3] = ((a1 >> 4) & M4) | (((t >> 6) & 0x03030303u) << 4);
    float acc = 0.0;
    for (uint n = 0u; n < 2u; n++)
        for (uint j = 0u; j < 4u; j++)
            for (uint hh = 0u; hh < 2u; hh++) {
                float a = 0.0;
                for (uint k = 0u; k < 4u; k++) {
                    uint q = LW(8u + 8u * n + 4u * hh + k), hm = LW(4u * hh + k);
                    a += dot4(((q >> (2u * j)) & 0x03030303u) | (((hm >> (4u * n + j)) & 0x01010101u) << 2), xb + 128u * n + 32u * j + 16u * hh + 4u * k);
                }
                uint is = 8u * n + 2u * j + hh;
                float sc = float(int((sw[is >> 2] >> (8u * (is & 3u))) & 0xFFu) - 32);
                acc += sc * (a - 4.0 * xs[sx + is]);
            }
    return d * acc;
}
#elif defined(FMT_IQ4_XS)
#define SB 256u
#define NW 34u
// words: 0 = d | scales_h<<16, 1 = scales_l, 2..33 = nibbles.   weight = d * (ls - 32) * level[code]
float superblock(uint xb) {
    uint w0 = LW(0u), sl = LW(1u), sx = xb >> 4;
    float d = unpackHalf2x16(w0).x, acc = 0.0;
    for (uint ib = 0u; ib < 8u; ib++) {
        float a = 0.0;
        for (uint k = 0u; k < 4u; k++) {
            uint v = LW(2u + 4u * ib + k), c = xb + 32u * ib + 4u * k;
            a += dot4c(v & M4, c) + dot4c((v >> 4) & M4, c + 16u);
        }
        uint ls = ((sl >> (4u * ib)) & 15u) | (((w0 >> (16u + 2u * ib)) & 3u) << 4);
        acc += float(int(ls) - 32) * (a - 127.0 * xsum32(sx + 2u * ib));
    }
    return d * acc;
}
#elif defined(FMT_IQ4_NL) || defined(FMT_Q4_0)
#define SB 64u
#define NW 9u
// words: 0 = d0 | d1<<16, 1..4 = nibbles of block 0, 5..8 = nibbles of block 1
float superblock(uint xb) {
    vec2 dd = unpackHalf2x16(LW(0u));
    uint sx = xb >> 4;
    float acc = 0.0;
    for (uint blk = 0u; blk < 2u; blk++) {
        float a = 0.0;
        for (uint k = 0u; k < 4u; k++) {
            uint v = LW(1u + 4u * blk + k), c = xb + 32u * blk + 4u * k;
#if defined(FMT_IQ4_NL)
            a += dot4c(v & M4, c) + dot4c((v >> 4) & M4, c + 16u);
#else
            a += dot4(v & M4, c) + dot4((v >> 4) & M4, c + 16u);
#endif
        }
#if defined(FMT_IQ4_NL)
        acc += dd[blk] * (a - 127.0 * xsum32(sx + 2u * blk));
#else
        acc += dd[blk] * (a - 8.0 * xsum32(sx + 2u * blk));
#endif
    }
    return acc;
}
#elif defined(FMT_Q8_0)
#define SB 64u
#define NW 17u
// words: 0 = d0 | d1<<16, 1..8 = bytes of block 0 (biased by 128), 9..16 = bytes of block 1
float superblock(uint xb) {
    vec2 dd = unpackHalf2x16(LW(0u));
    uint sx = xb >> 4;
    float acc = 0.0;
    for (uint blk = 0u; blk < 2u; blk++) {
        float a = 0.0;
        for (uint k = 0u; k < 8u; k++) a += dot4(LW(1u + 8u * blk + k), xb + 32u * blk + 4u * k);
        acc += dd[blk] * (a - 128.0 * xsum32(sx + 2u * blk));
    }
    return acc;
}
#elif defined(FMT_NVFP4)
#define SB 64u
#define NW 9u
// words: 0 = four UE4M3 sub-block scales, 1..8 = nibbles (sub-block s: words 1+2s, 2+2s)
float ue4m3_half(uint b) {
    uint e = (b >> 3) & 15u, m = b & 7u;
    float v = e == 0u ? float(m) * (1.0 / 1024.0) : uintBitsToFloat(((e + 119u) << 23) | (m << 20));
    return (b == 0u || b == 0x7Fu) ? 0.0 : v;
}
float superblock(uint xb) {
    uint w0 = LW(0u), sx = xb >> 4;
    float acc = 0.0;
    for (uint s = 0u; s < 4u; s++) {
        float a = 0.0;
        for (uint k = 0u; k < 2u; k++) {
            uint v = LW(1u + 2u * s + k), c = xb + 16u * s + 4u * k;
            a += dot4c(v & M4, c) + dot4c((v >> 4) & M4, c + 8u);
        }
        acc += ue4m3_half((w0 >> (8u * s)) & 0xFFu) * (a - 12.0 * xs[sx + s]);
    }
    return acc;
}
#else
#error "no weight format selected"
#endif

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.stride) return;
    float acc = 0.0;
    for (uint s = 0u; s < pc.n_sb; s++) {
        g_base = s * NW * pc.stride + row;
        acc += superblock(s * SB);
    }
    if (row < pc.n_rows) {
        if ((pc.flags & 1u) != 0u) acc += bias[pc.row0 + row];
        y[pc.row0 + row] = acc;
    }
}
