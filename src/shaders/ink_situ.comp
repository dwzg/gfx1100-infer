#version 460
#extension GL_GOOGLE_include_directive : require
// SITU activation of one expert's gate and up halves (Inkling), with the block sums the next
// matrix product needs:  act = beta * tanh(gate / beta) * sigmoid(gate) * lb * tanh(up / lb)
// One row of workgroups per (token, expert) pair, one lane per element.
#include "common.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer BG { float gu[]; };      // [pair][2 * nff]: gate, then up
layout(binding = 1) writeonly buffer BA { float act[]; };    // [pair][nff]
layout(binding = 2) writeonly buffer BS { float sums[]; };   // [pair][nff / 16]
layout(push_constant) uniform PC { uint nff; float beta; float lb; } pc;
shared float sv[64];
void main() {
    uint i = gl_GlobalInvocationID.x, pr = gl_WorkGroupID.y, lid = gl_LocalInvocationID.x;
    float v = 0.0;
    if (i < pc.nff) {
        float g = gu[pr * 2u * pc.nff + i], u = gu[pr * 2u * pc.nff + pc.nff + i];
        v = pc.beta * tanh(g / pc.beta) * sigmoid(g) * (pc.lb > 0.0 ? pc.lb * tanh(u / pc.lb) : u);
        act[pr * pc.nff + i] = v;
    }
    sv[lid] = v;
    barrier();
    if ((lid & 15u) == 0u && i < pc.nff) { float t = 0.0; for (uint k = 0u; k < 16u; k++) t += sv[lid + k]; sums[(pr * pc.nff + i) >> 4] = t; }
}
