#version 460
#extension GL_GOOGLE_include_directive : require
// Position bias by distance for each query head (Inkling), minus the head's sink logit:
//   table[t][h][e] = dot(bias[e], r[t][h]) - sink[t][h]   for e < extent;   -sink[t][h] for e == extent
// (the last entry serves every distance past the table). One lane per distance.
#include "common.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer BB { float bias[]; };    // [extent][nr]
layout(binding = 1) readonly buffer BR { float r[]; };       // [token][head][nr]
layout(binding = 2) readonly buffer BS { float sink[]; };    // [token][head]
layout(binding = 3) writeonly buffer BT { float table[]; };  // [token][head][extent + 1]
layout(push_constant) uniform PC { uint nr; uint extent; uint nh; } pc;
void main() {
    uint e = gl_GlobalInvocationID.x, h = gl_WorkGroupID.y, t = gl_WorkGroupID.z;
    if (e > pc.extent) return;
    float v = 0.0;
    if (e < pc.extent) for (uint k = 0u; k < pc.nr; k++) v += bias[e * pc.nr + k] * r[(t * pc.nh + h) * pc.nr + k];
    table[(t * pc.nh + h) * (pc.extent + 1u) + e] = v - sink[t * pc.nh + h];
}
