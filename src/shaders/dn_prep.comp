#version 460
#extension GL_GOOGLE_include_directive : require
// Linear-attention input stage. One workgroup per (head-sized block of channels, token), one lane
// per channel: causal depthwise convolution over the last KW projections, SiLU, and L2
// normalisation of the query and key blocks (the first n_norm blocks).
// The projections before the batch come from `hist`; dn_hist updates it afterwards.
#include "common.glsl"
layout(local_size_x_id = 0) in;   // = head_dim
layout(binding = 0) readonly buffer BM { float mixed[]; };   // [token][channel]
layout(binding = 1) readonly buffer BH { float hist[]; };    // [channel][KW-1], oldest first
layout(binding = 2) readonly buffer BCW { float cw[]; };     // [channel][KW]
layout(binding = 3) writeonly buffer BO { float o[]; };      // [token][channel]
layout(push_constant) uniform PC { uint n_norm; uint kw; float eps; uint c_total; } pc;
shared float red[gl_WorkGroupSize.x];

void main() {
    uint blk = gl_WorkGroupID.x, tk = gl_WorkGroupID.y, lid = gl_LocalInvocationID.x, S = gl_WorkGroupSize.x;
    uint c = blk * S + lid, hw = pc.kw - 1u;
    float s = 0.0;
    for (uint i = 0u; i < pc.kw; i++) {
        // tap i reads the projection of token tk - hw + i
        float v = tk + i >= hw ? mixed[(tk + i - hw) * pc.c_total + c] : hist[c * hw + tk + i];
        s += v * cw[c * pc.kw + i];
    }
    float v = silu(s);
    red[lid] = v * v;
    barrier();
    if (lid == 0u) { float t = 0.0; for (uint i = 0u; i < S; i++) t += red[i]; red[0] = t; }
    barrier();
    if (blk < pc.n_norm) v *= inversesqrt(red[0] + pc.eps);
    o[tk * pc.c_total + c] = v;
}
