#version 460
#extension GL_GOOGLE_include_directive : require
// Weighted sum of cached values, one segment of positions per workgroup.
// The value cache is row-major, [position][kv head][word]; one lane per word of a head's row, so a
// wave reads a whole row with one coalesced load, and the weights (one per position and query
// head) are the same for all lanes. Segments run in parallel; attn_combine adds them up.
#include "common.glsl"
layout(local_size_x_id = 0) in;                  // data words per head row
layout(constant_id = 1) const uint G = 1u;       // query heads per value head
layout(binding = 0) readonly buffer BVC { uint vc[]; };
layout(binding = 1) readonly buffer BSC { float sc[]; };    // exp(score - max), [query head][n_ctx]
layout(binding = 2) readonly buffer BCTL { uint pos; } ctl;
layout(binding = 3) writeonly buffer BP { float part[]; };  // [segment][query head][hd]
layout(push_constant) uniform PC { uint hd; uint nh; uint nkv; uint n_ctx; uint seg; } pc;
#ifdef KV8
#define VPW 4u       // values per word
#else
#define VPW 2u
#endif

void main() {
    uint sg = gl_WorkGroupID.x, kvh = gl_WorkGroupID.y, w = gl_LocalInvocationID.x;
    uint t0 = sg * pc.seg, t1 = min(ctl.pos + 1u, t0 + pc.seg);
    float acc[G * VPW];
    for (uint i = 0u; i < G * VPW; i++) acc[i] = 0.0;
#ifdef KV8
    uint pk = pc.hd / 4u + pc.hd / 64u, rv = pc.nkv * pk;
    for (uint t = t0; t < t1; t++) {
        uint rb = t * rv + kvh * pk;
        int wv = int(vc[rb + w]);
        float bs = unpackHalf2x16(vc[rb + pc.hd / 4u + (w >> 4)])[(w >> 3) & 1u];
        vec4 v = vec4(float(bitfieldExtract(wv, 0, 8)), float(bitfieldExtract(wv, 8, 8)), float(bitfieldExtract(wv, 16, 8)), float(wv >> 24)) * bs;
        for (uint g = 0u; g < G; g++) {
            float p = sc[(kvh * G + g) * pc.n_ctx + t];
            acc[g * 4u] += p * v.x; acc[g * 4u + 1u] += p * v.y; acc[g * 4u + 2u] += p * v.z; acc[g * 4u + 3u] += p * v.w;
        }
    }
#else
    uint pk = pc.hd / 2u, rv = pc.nkv * pk;
    for (uint t = t0; t < t1; t++) {
        vec2 v = unpackHalf2x16(vc[t * rv + kvh * pk + w]);
        for (uint g = 0u; g < G; g++) {
            float p = sc[(kvh * G + g) * pc.n_ctx + t];
            acc[g * 2u] += p * v.x; acc[g * 2u + 1u] += p * v.y;
        }
    }
#endif
    for (uint g = 0u; g < G; g++)
        for (uint i = 0u; i < VPW; i++) part[(sg * pc.nh + kvh * G + g) * pc.hd + w * VPW + i] = acc[g * VPW + i];
}
