#version 460
#extension GL_GOOGLE_include_directive : require
// Prepare tokens for full attention. One workgroup per (head, token), one lane per head dimension;
// token k of the batch sits at position ctl.pos + k:
//   query:  split off the output gate, RMS-normalise, rotate by position -> q, gate
//   key:    RMS-normalise, rotate by position -> key cache row `pos`
//   value:  -> value cache row `pos`
#include "common.glsl"
layout(local_size_x_id = 0) in;   // = head_dim
layout(binding = 0) readonly buffer BQF { float qfull[]; };
layout(binding = 1) readonly buffer BKR { float kraw[]; };
layout(binding = 2) readonly buffer BVR { float vraw[]; };
layout(binding = 3) readonly buffer BNW { float nw[]; };       // q-norm weight, then k-norm weight
layout(binding = 4) readonly buffer BCTL { uint pos; uint pad[3]; float rot[]; } ctl;  // rot: cos, sin per pair
layout(binding = 5) writeonly buffer BQ { float q[]; };
layout(binding = 6) writeonly buffer BGT { float gate[]; };
// Key cache: plane-major [kv head][plane][position]. Value cache: row-major [position][kv head][word].
// Half precision: two values per word. 8-bit (KV8): four signed bytes per word, followed by words
// holding two half-precision scales, one scale per 32 values.
layout(binding = 7) writeonly buffer BKC { uint kc[]; };
layout(binding = 8) writeonly buffer BVC { uint vc[]; };
#ifdef KV8
shared int sq[gl_WorkGroupSize.x];
#endif
layout(push_constant) uniform PC { uint hd; uint nh; uint nkv; uint qw; uint rope_dim; uint flags; float eps; uint stride; } pc;
// flags: 1 = normalise q and k, 2 = q carries a gate, 4 = rotation pairs are (i, i + rope_dim/2)
shared float sv[gl_WorkGroupSize.x];
shared float red[gl_WorkGroupSize.x];

// Normalise (optionally) and rotate this lane's element; all lanes of the workgroup call it together.
float norm_rotate(float v, uint w_off) {
    uint d = gl_LocalInvocationID.x;
    red[d] = v * v;
    barrier();
    if (d == 0u) { float s = 0.0; for (uint i = 0u; i < pc.hd; i++) s += red[i]; red[0] = s; }
    barrier();
    if ((pc.flags & 1u) != 0u) v *= inversesqrt(red[0] / float(pc.hd) + pc.eps) * nw[w_off + d];
    sv[d] = v;
    barrier();
    if (d < pc.rope_dim) {
        uint hf = pc.rope_dim / 2u, pair, other; bool first;
        if ((pc.flags & 4u) != 0u) { first = d < hf; pair = first ? d : d - hf; other = first ? d + hf : d - hf; }
        else { first = (d & 1u) == 0u; pair = d >> 1u; other = d ^ 1u; }
        uint rb = gl_WorkGroupID.y * pc.rope_dim + 2u * pair;
        float c = ctl.rot[rb], s = ctl.rot[rb + 1u];
        float x0 = first ? v : sv[other], x1 = first ? sv[other] : v;
        v = first ? x0 * c - x1 * s : x0 * s + x1 * c;
    }
    barrier();
    return v;
}

#ifdef KV8
// Quantise this lane's element with its 32-element block's scale. Returns the scale; the
// quantised value is left in sq[] for all lanes.
float quantise8(float v) {
    uint d = gl_LocalInvocationID.x;
    sv[d] = v;
    barrier();
    if ((d & 31u) == 0u) { float m = 0.0; for (uint i = 0u; i < 32u; i++) m = max(m, abs(sv[d + i])); red[d >> 5] = m; }
    barrier();
    float sc = float(float16_t(red[d >> 5] / 127.0));    // the scale as it will be stored
    sq[d] = sc > 0.0 ? int(clamp(round(v / sc), -127.0, 127.0)) : 0;
    barrier();
    return sc;
}
float block_scale(uint b) { return float(float16_t(red[b] / 127.0)); }
uint packed4(uint d) { return uint(sq[d] & 255) | (uint(sq[d + 1u] & 255) << 8) | (uint(sq[d + 2u] & 255) << 16) | (uint(sq[d + 3u]) << 24); }
#endif

void main() {
    uint g = gl_WorkGroupID.x, d = gl_LocalInvocationID.x, tk = gl_WorkGroupID.y, pos = ctl.pos + tk;
    uint qin = tk * pc.nh * pc.qw + g * pc.qw + d, qout = tk * pc.nh * pc.hd + g * pc.hd + d, kin = tk * pc.nkv * pc.hd + g * pc.hd + d;
    bool has_q = g < pc.nh, has_kv = g < pc.nkv;
    float qv = has_q ? qfull[qin] : 0.0;
    qv = norm_rotate(qv, 0u);
    if (has_q) {
        q[qout] = qv;
        if ((pc.flags & 2u) != 0u) gate[qout] = qfull[qin + pc.hd];
    }
    float kv = has_kv ? kraw[kin] : 0.0;
    kv = norm_rotate(kv, pc.hd);
    float vv = has_kv ? vraw[kin] : 0.0;
#ifdef KV8
    uint pk = pc.hd / 4u + pc.hd / 64u, vrow = pos * pc.nkv * pk + g * pk;
    quantise8(kv);
    if (has_kv && (d & 3u) == 0u) kc[(g * pk + (d >> 2)) * pc.stride + pos] = packed4(d);
    if (has_kv && (d & 63u) == 0u) kc[(g * pk + pc.hd / 4u + (d >> 6)) * pc.stride + pos] = packHalf2x16(vec2(block_scale(d >> 5), block_scale((d >> 5) + 1u)));
    barrier();
    quantise8(vv);
    if (has_kv && (d & 3u) == 0u) vc[vrow + (d >> 2)] = packed4(d);
    if (has_kv && (d & 63u) == 0u) vc[vrow + pc.hd / 4u + (d >> 6)] = packHalf2x16(vec2(block_scale(d >> 5), block_scale((d >> 5) + 1u)));
#else
    uint pk = pc.hd / 2u;
    sv[d] = kv; red[d] = vv;
    barrier();
    if (has_kv && (d & 1u) == 0u) {
        kc[(g * pk + (d >> 1)) * pc.stride + pos] = packHalf2x16(vec2(sv[d], sv[d + 1u]));
        vc[pos * pc.nkv * pk + g * pk + (d >> 1)] = packHalf2x16(vec2(red[d], red[d + 1u]));
    }
#endif
}
