#version 460
#extension GL_GOOGLE_include_directive : require
// act = silu(g) * u
#include "common.glsl"
layout(local_size_x = 64) in;
layout(binding = 0) readonly buffer BG { float g[]; };
layout(binding = 1) readonly buffer BU { float u[]; };
layout(binding = 2) writeonly buffer BY { float y[]; };
layout(push_constant) uniform PC { uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) y[i] = silu(g[i]) * u[i];
}
