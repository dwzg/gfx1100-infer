#version 460
#extension GL_GOOGLE_include_directive : require
// Softmax over the scores of one query head (one workgroup per head): replaces each score by
// exp(score - max) and stores 1 / sum.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(binding = 0) readonly buffer BCTL { uint pos; } ctl;
layout(binding = 1) buffer BSC { float sc[]; };
layout(binding = 2) writeonly buffer BZ { float z[]; };
layout(push_constant) uniform PC { uint n_ctx; uint nh; uint tq0; } pc;
shared float red[256];

void main() {
    uint h = gl_WorkGroupID.x, lq = gl_WorkGroupID.y, tq = pc.tq0 + lq, lid = gl_LocalInvocationID.x, n_pos = ctl.pos + tq + 1u, sb = (lq * pc.nh + h) * pc.n_ctx;
    float mx = -3.0e38;
    for (uint t = lid; t < n_pos; t += 256u) mx = max(mx, sc[sb + t]);
    red[lid] = mx;
    barrier();
    if (lid == 0u) { float m = red[0]; for (uint i = 1u; i < 256u; i++) m = max(m, red[i]); red[0] = m; }
    barrier();
    mx = red[0];
    barrier();
    float sum = 0.0;
    for (uint t = lid; t < n_pos; t += 256u) { float e = exp(sc[sb + t] - mx); sc[sb + t] = e; sum += e; }
    red[lid] = sum;
    barrier();
    if (lid == 0u) { float s = 0.0; for (uint i = 0u; i < 256u; i++) s += red[i]; z[tq * pc.nh + h] = 1.0 / s; }
}
