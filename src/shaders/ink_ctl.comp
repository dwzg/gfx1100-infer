#version 460
#extension GL_GOOGLE_include_directive : require
// Message controllers of looped layers (Inkling):
//   out = cur - tanh(F g) * cur + tanh(G g) * msg,   g = D [cur / rms(cur), msg / rms(msg)]
// in two steps, one workgroup per token each.
//   default: g (rank values; one lane per row of D)
//   OUT:     out, optionally (flag 1) RMS-normalised and scaled by w, with its 16-element block sums
#include "common.glsl"
layout(binding = 0) readonly buffer BC { float cur[]; };
layout(binding = 1) readonly buffer BM { float msg[]; };
#ifdef OUT
layout(local_size_x = 256) in;
layout(binding = 2) readonly buffer BL { float low[]; };     // [token][rank]
layout(binding = 3) readonly buffer BG { float gain[]; };    // [n][rank]
layout(binding = 4) readonly buffer BF { float forget[]; };  // [n][rank]
layout(binding = 5) buffer BO { float o[]; };                // [token][n]
layout(binding = 6) readonly buffer BW { float w[]; };
layout(binding = 7) writeonly buffer BS { float sums[]; };
layout(push_constant) uniform PC { uint n; uint rank; uint flags; float eps; } pc;
shared float red[256];
void main() {
    uint lid = gl_LocalInvocationID.x, t = gl_WorkGroupID.x, base = t * pc.n;
    float ss = 0.0;
    for (uint b = 16u * lid; b < pc.n; b += 4096u)
        for (uint i = b; i < min(b + 16u, pc.n); i++) {
            float g = 0.0, f = 0.0;
            for (uint k = 0u; k < pc.rank; k++) { float l = low[t * pc.rank + k]; g += gain[i * pc.rank + k] * l; f += forget[i * pc.rank + k] * l; }
            float c = cur[base + i], v = c - tanh(f) * c + tanh(g) * msg[base + i];
            o[base + i] = v;
            ss += v * v;
        }
    if ((pc.flags & 1u) == 0u) return;
    red[lid] = ss;
    barrier();
    for (uint h = 128u; h > 0u; h >>= 1u) {
        if (lid < h) red[lid] += red[lid + h];
        barrier();
    }
    float scale = inversesqrt(red[0] / float(pc.n) + pc.eps);
    for (uint b = 16u * lid; b < pc.n; b += 4096u) {
        float bsum = 0.0;
        for (uint i = b; i < min(b + 16u, pc.n); i++) { float v = o[base + i] * scale * w[i]; o[base + i] = v; bsum += v; }
        sums[(base + b) >> 4] = bsum;
    }
}
#else
layout(local_size_x = 64) in;
layout(binding = 2) readonly buffer BD { float down[]; };    // [rank][2n]
layout(binding = 3) writeonly buffer BL { float low[]; };    // [token][rank]
layout(push_constant) uniform PC { uint n; uint rank; } pc;
shared float red[2][64];
void main() {
    uint lid = gl_LocalInvocationID.x, t = gl_WorkGroupID.x, base = t * pc.n;
    float a = 0.0, b = 0.0;
    for (uint i = lid; i < pc.n; i += 64u) { float u = cur[base + i], v = msg[base + i]; a += u * u; b += v * v; }
    red[0][lid] = a; red[1][lid] = b;
    barrier();
    for (uint h = 32u; h > 0u; h >>= 1u) {
        if (lid < h) { red[0][lid] += red[0][lid + h]; red[1][lid] += red[1][lid + h]; }
        barrier();
    }
    float ia = inversesqrt(red[0][0] / float(pc.n) + 1.0e-6), ib = inversesqrt(red[1][0] / float(pc.n) + 1.0e-6);
    for (uint r = lid; r < pc.rank; r += 64u) {
        uint wb = r * 2u * pc.n;
        float s0 = 0.0, s1 = 0.0;
        for (uint i = 0u; i < pc.n; i++) { s0 += down[wb + i] * cur[base + i]; s1 += down[wb + pc.n + i] * msg[base + i]; }
        low[t * pc.rank + r] = s0 * ia + s1 * ib;
    }
}
#endif
